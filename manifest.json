{
  "manifest_version": 3,
  "name": "Vinted Republisher PRO",
  "version": "2.2.13",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "scripting",
    "webNavigation",
    "webRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://*.vinted.fr/*",
    "https://*.vinted.com/*",
    "https://*.vinted.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.vinted.fr/*", "https://*.vinted.com/*"],
      "js": ["image-processor.js", "vinted-field-matrix.js", "vinted-schema-store.js", "vinted-schema-discovery.js", "vinted-form-engine.js", "vinted-schema-crawler.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["automation-engine-fresh.js", "vinted-field-matrix.js", "vinted-schema-store.js", "vinted-schema-discovery.js", "vinted-form-engine.js", "vinted-schema-crawler.js", "vinted-form-schemas.generated.json"],
      "matches": ["https://*.vinted.fr/*", "https://*.vinted.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
